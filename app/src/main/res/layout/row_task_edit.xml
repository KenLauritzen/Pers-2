<?xml version="1.0" encoding="utf-8"?>
<!--
  Two lines per task: figures above, description below.

  The description gets the full width rather than competing with the times,
  which matters for long titles. It wraps, so a task can be several lines and
  the row's height varies with its content.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- Tapping the marker cycles open / doing / done / archived -->
    <TextView
        android:id="@+id/taskMark"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:gravity="center"
        android:textSize="30sp"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_button_small" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/taskTimes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#8FA39E"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/taskText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#F1EDE3"
            android:textSize="17sp" />
    </LinearLayout>

</LinearLayout>
