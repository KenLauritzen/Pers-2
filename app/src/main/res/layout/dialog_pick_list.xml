<?xml version="1.0" encoding="utf-8"?>
<!--
  A compact chooser. AlertDialog's own list pads each item for a large touch
  target, which is right for three options and wasteful for twenty — you can
  see half as many as the screen could hold.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2C2A"
    android:padding="14dp">

    <TextView
        android:id="@+id/pickTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E8A33D"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp">

        <LinearLayout
            android:id="@+id/pickList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/pickCancel"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:text="Cancel"
        android:textAllCaps="false"
        android:textColor="#8FA39E"
        android:textSize="15sp"
        android:background="@drawable/bg_button_small" />

</LinearLayout>
