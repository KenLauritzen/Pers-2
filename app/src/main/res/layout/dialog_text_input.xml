<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared by every small text-entry dialog: new label, save layout, rename
  layout, edit task.

  These used to be EditTexts handed to a plain AlertDialog, which draws white
  while the fields carried the app's cream text — unreadable. A layout with its
  own background fixes that and keeps them looking like the rest of the app.

  The second field and the delete button are hidden unless a caller needs them.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2C2A"
    android:padding="16dp">

    <TextView
        android:id="@+id/inputTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#E8A33D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/inputPrimary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#F1EDE3"
        android:textColorHint="#5C736E"
        android:textSize="20sp"
        android:padding="12dp"
        android:background="@drawable/bg_row_track"
        android:importantForAutofill="no"
        android:singleLine="true" />

    <EditText
        android:id="@+id/inputSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#F1EDE3"
        android:textColorHint="#5C736E"
        android:textSize="20sp"
        android:padding="12dp"
        android:background="@drawable/bg_row_track"
        android:inputType="number"
        android:importantForAutofill="no"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/inputDelete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginEnd="5dp"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="#C97064"
            android:textSize="16sp"
            android:padding="0dp"
            android:background="@drawable/bg_button_small"
            android:visibility="gone" />

        <Button
            android:id="@+id/inputCancel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:layout_marginEnd="5dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#8FA39E"
            android:textSize="16sp"
            android:padding="0dp"
            android:background="@drawable/bg_button_small" />

        <Button
            android:id="@+id/inputSave"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="46dp"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="#E8A33D"
            android:textSize="16sp"
            android:padding="0dp"
            android:background="@drawable/bg_button_small" />
    </LinearLayout>

</LinearLayout>
