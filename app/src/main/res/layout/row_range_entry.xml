<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/rangeLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#F1EDE3"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/rangeHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A9BDB8"
            android:fontFamily="monospace"
            android:textSize="19sp" />

        <TextView
            android:id="@+id/rangePercent"
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="#8FA39E"
            android:fontFamily="monospace"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Share of the range's total, not progress toward a goal. Goals are
         daily and mean nothing across a fortnight; a share always does. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:background="#1A2C2A">

        <View
            android:id="@+id/rangeBar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#3A6841" />

        <View
            android:id="@+id/rangeBarRest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>
