<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12201E"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Range totals"
        android:textColor="#E8A33D"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Either end opens a date picker. The start defaults to the most recent
         Sunday at midnight; the end to now. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:background="@drawable/bg_row_track">

        <TextView
            android:id="@+id/rangeFrom"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F1EDE3"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  \u2192  "
            android:textColor="#5C736E"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/rangeTo"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F1EDE3"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:id="@+id/rangeList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:background="#2E4A46" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="10dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Total"
            android:textColor="#8FA39E"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/rangeTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9FD8A8"
            android:fontFamily="monospace"
            android:textSize="24sp" />
    </LinearLayout>

    <!-- 48:55 across a week is seven hours a day; across a fortnight it's
         half that. The headline means little without this. -->
    <TextView
        android:id="@+id/rangeAverage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#8FA39E"
        android:textSize="14sp"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/rangeDone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Done"
        android:textAllCaps="false"
        android:textColor="#E8A33D"
        android:textSize="16sp"
        android:background="@drawable/bg_button_small" />

</LinearLayout>
