<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rowRoot"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_row_track"
    android:clickable="true"
    android:focusable="true">

    <!-- Progress fill: amber up to goal, green beyond, grey remainder -->
    <LinearLayout
        android:id="@+id/barContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:weightSum="1">

        <!-- Progress up to the goal.
             Was #2A4A2E, which scored only 1.47 contrast against the track it
             sits on and barely read as a bar at all. #3A6841 is about twice
             that, while keeping the 32sp timer above 3:1. -->
        <View
            android:id="@+id/barProgress"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#3A6841" />

        <!-- Time beyond the goal.
             Was #4A2A18 at 1.14 against the track — all but invisible, so
             going over a goal didn't register. -->
        <View
            android:id="@+id/barOver"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0"
            android:background="#8C4726" />

        <View
            android:id="@+id/barRest"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Content sits on top of the bar. Three weighted columns rather than a
         centred timer, so the label and the duration can't occupy the same
         space no matter how long either gets. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:weightSum="1">

        <ImageView
            android:id="@+id/rowNote"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:padding="6dp"
            android:src="@drawable/ic_note"
            android:contentDescription="Notes"
            android:clickable="true"
            android:focusable="true" />

        <!-- Label with an optional second figure beneath it. The container
             centres its children, so with no second line the label sits
             centred exactly as before. -->
        <LinearLayout
            android:id="@+id/rowLabelBox"
            android:layout_width="0dp"
            android:layout_weight="0.30"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/rowLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Timer"
                android:textColor="#F1EDE3"
                android:textSize="17sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/rowSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Right-aligned so the colons stay put as the hours digit appears -->
        <TextView
            android:id="@+id/rowTime"
            android:layout_width="0dp"
            android:layout_weight="0.40"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="00:00"
            android:textColor="#E8A33D"
            android:fontFamily="monospace"
            android:textSize="32sp"
            android:maxLines="1"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/rowGoal"
            android:layout_width="0dp"
            android:layout_weight="0.30"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text=""
            android:textColor="#A9BDB8"
            android:fontFamily="monospace"
            android:textSize="22sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Border drawn last so it sits above the fill -->
    <View
        android:id="@+id/rowBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_row_idle" />

</FrameLayout>
