<?xml version="1.0" encoding="utf-8"?>
<!--
  Landscape only. Seven columns need about 114dp each; portrait gives 51dp,
  which isn't enough for "05:00 120m Fitness".
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#12201E"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/weekPrev"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="\u2039"
            android:textColor="#E8A33D"
            android:textSize="26sp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/weekTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#E8A33D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/weekNext"
            android:layout_width="44dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="\u203a"
            android:textColor="#E8A33D"
            android:textSize="26sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- A gesture whose meaning is invisible while your finger is down is
             where mistakes come from. -->
        <TextView
            android:id="@+id/weekModes"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:text="\u2195 move   \u2194 duration"
            android:textColor="#8FA39E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/weekAction"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Week\u2026"
            android:textColor="#9FD8A8"
            android:textSize="12sp"
            android:background="@drawable/bg_button_small"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/weekDone"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:layout_marginStart="5dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Done"
            android:textColor="#E8A33D"
            android:textSize="12sp"
            android:background="@drawable/bg_button_small"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/weekColumns"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="7" />

</LinearLayout>
