<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2C2A"
    android:padding="16dp">

    <!-- Two explicit lines rather than one wrapping string: a value split
         from its own label reads as broken. Goal and today stack on the right
         so their figures line up under each other. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_row_track">

        <TextView
            android:id="@+id/editName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#E8A33D"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/editGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8A33D"
                android:fontFamily="monospace"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/editToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#A9BDB8"
                android:fontFamily="monospace"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Goal: green adds, red subtracts. Four per row rather than five, so
         the larger type has room. -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="14dp">
        <TextView
            android:layout_width="52dp" android:layout_height="wrap_content"
            android:text="Goal" android:textColor="#8FA39E" android:textSize="17sp" />
        <Button android:id="@+id/eG1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="+1"
            android:textAllCaps="false" android:textColor="#7DBE7A" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="+5"
            android:textAllCaps="false" android:textColor="#7DBE7A" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="+15"
            android:textAllCaps="false" android:textColor="#7DBE7A" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG60" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:text="+60"
            android:textAllCaps="false" android:textColor="#7DBE7A" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="5dp">
        <TextView
            android:layout_width="52dp" android:layout_height="wrap_content"
            android:text="" android:textSize="17sp" />
        <Button android:id="@+id/eGm1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="-1"
            android:textAllCaps="false" android:textColor="#C97064" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="-5"
            android:textAllCaps="false" android:textColor="#C97064" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="-15"
            android:textAllCaps="false" android:textColor="#C97064" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm60" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:text="-60"
            android:textAllCaps="false" android:textColor="#C97064" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <!-- Today's recorded time; applies immediately and is written to the log -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="16dp">
        <TextView
            android:layout_width="52dp" android:layout_height="wrap_content"
            android:text="Time" android:textColor="#8FA39E" android:textSize="17sp" />
        <Button android:id="@+id/eTm15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="-15"
            android:textAllCaps="false" android:textColor="#6FAFC4" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eTm5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="-5"
            android:textAllCaps="false" android:textColor="#6FAFC4" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eT5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:layout_marginEnd="4dp" android:text="+5"
            android:textAllCaps="false" android:textColor="#6FAFC4" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eT15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="52dp" android:text="+15"
            android:textAllCaps="false" android:textColor="#6FAFC4" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <!-- Tasks: how many show under this label's row while it runs, and the
         way into the editor.
         
         It lives here rather than only in the editor because a count of zero
         hides the row's task block, and the edit icon with it — leaving no
         route back. This popup is always reachable. -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="16dp">
        <TextView
            android:layout_width="52dp" android:layout_height="wrap_content"
            android:text="Tasks" android:textColor="#8FA39E" android:textSize="17sp" />
        <Button android:id="@+id/eTaskMinus" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:layout_marginEnd="4dp" android:text="\u2212"
            android:textAllCaps="false" android:textColor="#C97064" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <TextView
            android:id="@+id/eTaskCount"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#F1EDE3" android:fontFamily="monospace"
            android:textSize="20sp" />
        <Button android:id="@+id/eTaskPlus" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="52dp"
            android:layout_marginEnd="4dp" android:text="+"
            android:textAllCaps="false" android:textColor="#7DBE7A" android:textSize="18sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eTaskEdit" android:layout_width="0dp"
            android:layout_weight="1.4" android:layout_height="52dp"
            android:text="Edit\u2026"
            android:textAllCaps="false" android:textColor="#E8A33D" android:textSize="16sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <!-- Delete and Done side by side. Done weighted lighter so the destructive
         action isn't the one nearest the thumb by default. -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="18dp">
        <Button
            android:id="@+id/eDelete"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:layout_marginEnd="6dp"
            android:text="Delete label"
            android:textAllCaps="false"
            android:textColor="#C97064"
            android:textSize="18sp"
            android:padding="0dp"
            android:background="@drawable/bg_button_small" />
        <Button
            android:id="@+id/eDone"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="52dp"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="#E8A33D"
            android:textSize="18sp"
            android:padding="0dp"
            android:background="@drawable/bg_button_small" />
    </LinearLayout>

</LinearLayout>
