<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2C2A"
    android:padding="16dp">

    <!-- Two explicit lines rather than one wrapping string: a value split
         from its own label reads as broken. Goal and today stack on the right
         so their figures line up under each other. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_row_track">

        <TextView
            android:id="@+id/editName"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textColor="#E8A33D"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/editGoal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E8A33D"
                android:fontFamily="monospace"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/editToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#A9BDB8"
                android:fontFamily="monospace"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Goal: add on the first row, subtract on the second, floored at zero -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="12dp">
        <TextView
            android:layout_width="42dp" android:layout_height="wrap_content"
            android:text="Goal" android:textColor="#8FA39E" android:textSize="12sp" />
        <Button android:id="@+id/eG1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="+1"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="+5"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="+15"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG30" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="+30"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eG60" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:text="+60"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="4dp">
        <TextView
            android:layout_width="42dp" android:layout_height="wrap_content"
            android:text="" android:textSize="12sp" />
        <Button android:id="@+id/eGm1" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="-1"
            android:textAllCaps="false" android:textColor="#8FA39E" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="-5"
            android:textAllCaps="false" android:textColor="#8FA39E" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="-15"
            android:textAllCaps="false" android:textColor="#8FA39E" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm30" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="-30"
            android:textAllCaps="false" android:textColor="#8FA39E" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eGm60" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:text="-60"
            android:textAllCaps="false" android:textColor="#8FA39E" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <!-- Today's recorded time; applies immediately and is written to the log -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginTop="14dp">
        <TextView
            android:layout_width="42dp" android:layout_height="wrap_content"
            android:text="Time" android:textColor="#8FA39E" android:textSize="12sp" />
        <Button android:id="@+id/eTm15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="-15"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eTm5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="-5"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eT5" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:layout_marginEnd="3dp" android:text="+5"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
        <Button android:id="@+id/eT15" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="42dp" android:text="+15"
            android:textAllCaps="false" android:textColor="#F1EDE3" android:textSize="12sp"
            android:padding="0dp" android:background="@drawable/bg_button_small" />
    </LinearLayout>

    <Button
        android:id="@+id/eDelete"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:text="Delete label"
        android:textAllCaps="false"
        android:textColor="#C97064"
        android:textSize="12sp"
        android:background="@drawable/bg_button_small" />

</LinearLayout>
