<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A2C2A"
    android:padding="16dp">

    <TextView
        android:id="@+id/layoutPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Layouts"
        android:textColor="#E8A33D"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp" />

    <EditText
        android:id="@+id/layoutFilter"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:hint="Search layouts"
        android:textColorHint="#5C736E"
        android:textColor="#F1EDE3"
        android:textSize="15sp"
        android:background="@drawable/bg_row_track"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:inputType="text"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/layoutHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Long-press a layout to rename or delete it"
        android:textColor="#5C736E"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/layoutList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
